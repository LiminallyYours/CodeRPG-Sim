{
  "env": {
    "CLAUDE_CODE_FORK_SUBAGENT": "0"
  },
  "permissions": {
    "allow": [
      "Bash(python3 rules/rpg.py *)",
      "Bash(python3 tools/ask.py *)",
      "Bash(python3 tools/voice.py *)",
      "Read(games/**)",
      "Read(rules/**)",
      "Read(state/**)",
      "Edit(proposals/**)",
      "Edit(state/forge/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/session_start.py\""
          }
        ]
      }
    ]
  }
}
